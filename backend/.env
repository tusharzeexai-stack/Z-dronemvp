# ============================================================
# Z-DRONE Backend Environment Variables
# Fill in all values below before running the backend
# ============================================================

# --- Database (AWS RDS PostgreSQL) ---
# Format: postgresql+asyncpg://username:password@hostname:5432/dbname
DATABASE_URL=postgresql+asyncpg://zdrone_admin:YOUR_PASSWORD@YOUR_RDS_ENDPOINT.rds.amazonaws.com:5432/zdrone_db

# --- JWT Authentication ---
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- AWS Credentials ---
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1

# --- AWS Kinesis Video Streams ---
# Stream name for each drone camera (format: zdrone-{drone_id}-stream)
KVS_STREAM_NAME_PREFIX=zdrone

# --- App Settings ---
# Comma-separated list of allowed frontend origins (Vercel URL + localhost)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
DEBUG=true
PORT=8000

# --- Admin User (created on first startup) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Zeex@admin
