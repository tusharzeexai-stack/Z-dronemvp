# Vite / React frontend environment variables
# Copy this to .env.local and fill in your values

# Backend API URL (local dev)
VITE_API_URL=http://localhost:8000

# AWS Region (for KVS WebRTC client-side)
VITE_AWS_REGION=ap-south-1

# Production backend URL (uncomment and set when deploying to AWS)
# VITE_API_URL=http://13.200.250.121:8000
